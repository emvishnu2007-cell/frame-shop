{
  "name": "frame-shop",
  "version": "1.0.0",
  "private": true,
  "description": "Full-stack custom photo frame shop: storefront, booking, admin panel, email and PDF invoices",
  "engines": { "node": ">=18" },
  "scripts": {
    "postinstall": "npm --prefix client install",
    "dev": "concurrently -n server,client -c yellow,cyan \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node --watch server/server.js",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "start": "cross-env NODE_ENV=production node server/server.js",
    "db:init": "node server/db/init.js",
    "db:seed": "node server/db/seed.js",
    "db:reset": "node server/db/seed.js --reset",
    "test:flow": "node server/tests/flow.test.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.3.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.15",
    "pdfkit": "^0.15.0",
    "razorpay": "^2.9.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3"
  }
}
