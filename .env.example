# ---------- Server ----------
PORT=5000
NODE_ENV=development
# Public URL of the website (used in emails and CORS). In dev the Vite client runs on 5173.
CLIENT_URL=http://localhost:5173

# ---------- Database ----------
# SQLite file path (relative to project root)
DATABASE_URL=./data/frameshop.db

# ---------- Security ----------
# Use a long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h

# ---------- Default admin (created by the seed script) ----------
ADMIN_EMAIL=admin@frameshop.local
ADMIN_PASSWORD=Admin@12345

# ---------- Email (SMTP) ----------
# Gmail example: host smtp.gmail.com, port 587, user = your gmail, password = an "App Password"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Frame Shop

# ---------- Shop defaults (can be changed later in Admin > Settings) ----------
SHOP_NAME=Delight Digital Frames
SHOP_EMAIL=hello@aurumframes.in
SHOP_PHONE=+91 98765 43210

# ---------- Razorpay (optional online payments) ----------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
